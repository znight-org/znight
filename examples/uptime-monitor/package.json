{
  "name": "@znight-examples/uptime-monitor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "znight generate",
    "dev": "znight dev",
    "build": "znight build",
    "start": "znight start",
    "typecheck": "znight generate && tsc --noEmit",
    "test": "bun test --conditions=@znight/source --timeout 30000",
    "test:e2e": "ZNIGHT_E2E=1 bun test --conditions=@znight/source --timeout 300000 test/e2e.test.ts",
    "test:integration": "ZNIGHT_INTEGRATION=1 bun test --conditions=@znight/source --timeout 180000 test/redis-lock-store.test.ts"
  },
  "dependencies": {
    "@znight/core": "workspace:*",
    "@znight/http": "workspace:*",
    "@znight/schedule": "workspace:*",
    "@znight/config": "workspace:*",
    "@znight/observability": "workspace:*",
    "hono": "4.13.14",
    "@hono/node-server": "2.1.5",
    "@electric-sql/pglite": "0.5.12",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@znight/compiler": "workspace:*",
    "@znight/cli": "workspace:*",
    "@znight/testing": "workspace:*",
    "vite": "catalog:",
    "typescript": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "testcontainers": "12.2.1",
    "@testcontainers/redis": "12.2.1"
  }
}
