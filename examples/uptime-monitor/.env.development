# Development settings, loaded by ConfigPlugin when NODE_ENV=development (`znight dev` sets it).
# Real environment variables win over this file. Never put production secrets here.
API_KEY=dev-admin-key
READONLY_API_KEY=dev-reader-key
LOG_LEVEL=debug
EXPOSE_ERRORS=true
# Default zone of the cron jobs that do not name one (probes.purge runs at 03:30 Paris time).
# digest.daily names its own zone (Europe/Paris) in its decorator.
SCHEDULE_TIME_ZONE=Europe/Paris
# DIGEST_CRON is left unset: digest.daily keeps the schedule of its decorator (08:00 on weekdays).
# Try DIGEST_CRON='*/2 * * * *' to receive a digest every two minutes.
# Keep monitors and results across restarts (git-ignored).
DATABASE_DATA_DIR=./data/uptime
