# Development settings, loaded by ConfigPlugin when NODE_ENV=development (`bun run dev` sets it).
# Real environment variables win over this file. Never put production secrets here: production
# reads them from its environment (or a secret store such as Vault, see @znight/config).

# Tokens: the key set written by `bun scripts/dev-token.ts` (run it once), for its issuer and audience.
# Production sets AUTH_JWKS_URL, the key set of the identity provider, instead of AUTH_JWKS_FILE.
AUTH_ISSUER=https://id.notes.localhost/
AUTH_AUDIENCE=https://api.notes.localhost
AUTH_JWKS_FILE=.dev/jwks.json

# The export client (x-api-key): the current key, then the next one during a rotation
EXPORT_API_KEYS=dev-export-key,dev-export-key-next

# Cookie sessions of the web front-end: signing keys (32+ bytes each), and the accounts with the
# scrypt hashes of their passwords (`printf '%s' '<password>' | bun scripts/hash-password.ts`).
# Development passwords: ada / ada-dev-password (editor), grace / grace-dev-password (admin, editor).
SESSION_SECRETS=dev-only-session-secret-0123456789abcdef
LOCAL_ACCOUNTS='[{"id":"acc-ada","username":"ada","roles":["editor"],"passwordHash":"$scrypt$ln=17,r=8,p=1$6Xun7WPxjHFP/wUYBUkcAA$lgy8/ziMO9adK6afMeGm7Ea4sSvP+cPqtkgayP3pnlk"},{"id":"acc-grace","username":"grace","roles":["admin","editor"],"passwordHash":"$scrypt$ln=17,r=8,p=1$v8uus0dZ/riniJN0LNeCBA$rQD5RwQqm+fESYVButtQCYOYvQTlSea/WIGcOL1dNKo"}]'

# Shared with the billing provider, which signs its webhook deliveries with it
WEBHOOK_SECRET=dev-webhook-secret

# A browser front-end served by Vite on its default port (CORS, and the origin check of CsrfGuard)
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=debug
EXPOSE_ERRORS=true
