# Every setting of the worker, with its default. Copy to .env (git-ignored) and adjust.
# Files loaded by ConfigPlugin, lowest precedence first: .env, .env.local, .env.<NODE_ENV>,
# .env.<NODE_ENV>.local; the real environment wins over all of them.

# --- worker (src/worker.config.ts)
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# RabbitMQ when set (secret: masked in logs), the in-memory broker otherwise
# RABBITMQ_URL=amqp://guest:guest@localhost:5672
# also read jobs from stdin, one JSON object per line
WORKER_STDIN_INBOX=false

# --- SMTP (src/emails/smtp.config.ts)
SMTP_HOST=localhost
SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
SMTP_FROM="Znight Worker <no-reply@example.com>"
# simulated latency of the fake SMTP server
SMTP_LATENCY_MS=20

# --- reports (src/reports/reports.config.ts)
# default: <os temp dir>/znight-worker/reports
# REPORTS_OUTPUT_DIR=
# simulated cost of one day of data
REPORTS_MS_PER_DAY=5
