{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "ESNext.Disposable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    // Znight decorators are TypeScript decorators: no emitDecoratorMetadata nor reflect-metadata
    "experimentalDecorators": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    // In-repo only: type-check against the TypeScript sources of the @znight/* workspace packages
    // (their `@znight/source` export condition, whose imports end with `.ts`) instead of their
    // build. Not needed in your project.
    "customConditions": ["@znight/source"],
    "allowImportingTsExtensions": true
  },
  "include": ["src", "test", "vite.config.ts", "znight.config.ts"]
}
