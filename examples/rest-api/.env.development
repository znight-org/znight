# Development settings, loaded by ConfigPlugin when NODE_ENV=development (`znight dev` sets it).
# Real environment variables win over this file. Never put production secrets here: production
# reads them from its environment (or a secret store such as Vault, see @znight/config).
API_KEY=dev-admin-key
READONLY_API_KEY=dev-reader-key
DATABASE_SEED=true
LOG_LEVEL=debug
EXPOSE_ERRORS=true
# A browser front-end served by Vite on its default port may call the API (CORS)
CORS_ORIGINS=http://localhost:5173
