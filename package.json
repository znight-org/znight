{
  "name": "@znight/source",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24",
    "bun": ">=1.3"
  },
  "workspaces": {
    "packages": ["packages/*", "examples/*", "docs"],
    "catalog": {
      "@types/bun": "1.4.4",
      "@types/node": "24.19.2",
      "typescript": "7.0.2",
      "tsdown": "0.23.2",
      "vite": "8.3.5",
      "zod": "4.6.7"
    }
  },
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "test": "bun test --conditions=@znight/source",
    "test:coverage": "bun test --conditions=@znight/source --coverage",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "biome check --diagnostic-level=error",
    "check:fix": "biome check --write",
    "lint": "biome lint",
    "format": "biome format --write",
    "postinstall": "husky",
    "docs:dev": "bun run --filter @znight/docs dev",
    "docs:build": "bun run --filter @znight/docs build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
