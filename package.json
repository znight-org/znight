{
  "name": "@znight/source",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24",
    "bun": ">=1.3"
  },
  "workspaces": {
    "packages": ["packages/*", "examples/*", "examples/monorepo/packages/*", "examples/monorepo/services/*", "docs"],
    "catalog": {
      "@types/bun": "1.4.4",
      "@types/node": "24.19.2",
      "typescript": "7.0.2",
      "tsdown": "0.23.2",
      "vite": "8.3.5",
      "zod": "4.6.7"
    }
  },
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "test": "bun test --conditions=@znight/source ./packages ./docs ./tests",
    "test:coverage": "bun test --conditions=@znight/source --coverage ./packages ./docs ./tests",
    "test:examples": "bun run --filter './examples/**' test",
    "test:e2e": "bun run build && ZNIGHT_E2E=1 bun run test:examples && ZNIGHT_E2E=1 bun test --conditions=@znight/source --timeout 300000 ./tests && ZNIGHT_CLI_E2E=1 bun test --conditions=@znight/source --timeout 300000 ./packages/cli/test/e2e.test.ts",
    "test:integration": "ZNIGHT_INTEGRATION=1 bun test --conditions=@znight/source --timeout 180000 ./packages/messaging/test/integration",
    "typecheck": "bun run --filter '*' typecheck && tsc --noEmit -p tests && tsc --noEmit -p scripts/release",
    "check": "biome check --diagnostic-level=error",
    "check:fix": "biome check --write",
    "lint": "biome lint",
    "format": "biome format --write",
    "postinstall": "husky",
    "docs:dev": "bun run --filter @znight/docs dev",
    "docs:build": "bun run --filter @znight/docs build",
    "changeset": "changeset",
    "version": "changeset version && bun install",
    "release": "bun run build && bun scripts/release/publish.ts",
    "release:pack": "bun scripts/release/pack.ts",
    "release:status": "bun scripts/release/status.ts",
    "release:smoke": "bun scripts/release/smoke.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@changesets/cli": "3.0.3",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
