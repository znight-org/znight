{
  "name": "@znight/observability",
  "version": "0.1.2",
  "description": "Znight observability plugin: structured logging (Pino), Prometheus metrics and OpenTelemetry tracing",
  "license": "MIT",
  "author": "Ugho STEPHAN",
  "homepage": "https://github.com/znight-org/znight/tree/main/packages/observability#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/znight-org/znight.git",
    "directory": "packages/observability"
  },
  "bugs": "https://github.com/znight-org/znight/issues",
  "keywords": [
    "znight",
    "observability",
    "logging",
    "pino",
    "metrics",
    "prometheus",
    "tracing",
    "opentelemetry",
    "datadog",
    "cloudwatch"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@znight/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@znight/core": "workspace:*",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "3.0.0",
    "@opentelemetry/core": "3.0.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "pino-pretty": "13.2.0",
    "prom-client": "15.1.3"
  },
  "peerDependencies": {
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.0.0"
  },
  "peerDependenciesMeta": {
    "pino-pretty": {
      "optional": true
    },
    "prom-client": {
      "optional": true
    }
  },
  "znight": {
    "apiVersion": 1,
    "provides": [
      {
        "export": "Logger",
        "plugin": "ObservabilityPlugin",
        "scope": "singleton"
      },
      {
        "export": "MetricsRegistry",
        "plugin": "ObservabilityPlugin",
        "scope": "singleton"
      },
      {
        "export": "Tracer",
        "plugin": "ObservabilityPlugin",
        "scope": "singleton"
      },
      {
        "export": "LoggedInterceptor",
        "plugin": "ObservabilityPlugin",
        "scope": "singleton"
      },
      {
        "export": "TracedInterceptor",
        "plugin": "ObservabilityPlugin",
        "scope": "singleton"
      },
      {
        "export": "MetricInterceptor",
        "plugin": "ObservabilityPlugin",
        "scope": "singleton"
      }
    ],
    "interceptors": [
      {
        "decorator": "Logged",
        "interceptor": "LoggedInterceptor"
      },
      {
        "decorator": "Traced",
        "interceptor": "TracedInterceptor"
      },
      {
        "decorator": "Metric",
        "interceptor": "MetricInterceptor"
      }
    ]
  }
}
