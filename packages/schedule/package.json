{
  "name": "@znight/schedule",
  "version": "0.1.3",
  "description": "Znight schedule: cron, interval and timeout jobs validated at build time, with distributed locks and graceful shutdown",
  "license": "MIT",
  "author": "Ugho STEPHAN",
  "homepage": "https://github.com/znight-org/znight/tree/main/packages/schedule#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/znight-org/znight.git",
    "directory": "packages/schedule"
  },
  "bugs": "https://github.com/znight-org/znight/issues",
  "keywords": ["znight", "schedule", "cron", "scheduler", "jobs", "interval"],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@znight/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./testing": {
      "@znight/source": "./src/testing/index.ts",
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    },
    "./compiler": {
      "@znight/source": "./src/compiler/index.ts",
      "types": "./dist/compiler.d.mts",
      "default": "./dist/compiler.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "bun test --conditions=@znight/source test",
    "test:integration": "ZNIGHT_INTEGRATION=1 bun test --conditions=@znight/source --timeout 180000 test/integration"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@znight/core": "workspace:*"
  },
  "peerDependencies": {
    "@znight/compiler": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@znight/compiler": {
      "optional": true
    }
  },
  "devDependencies": {
    "@znight/compiler": "workspace:*",
    "@znight/testing": "workspace:*",
    "croner": "11.0.0",
    "fast-check": "4.10.2",
    "testcontainers": "12.2.1",
    "@testcontainers/redis": "12.2.1"
  },
  "znight": {
    "apiVersion": 1,
    "compiler": "@znight/schedule/compiler",
    "provides": [
      {
        "export": "SchedulerRegistry",
        "plugin": "SchedulePlugin",
        "scope": "singleton"
      },
      {
        "export": "JobContext",
        "plugin": "SchedulePlugin",
        "scope": "request"
      }
    ]
  }
}
