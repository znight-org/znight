{
  "name": "@znight/http",
  "version": "0.1.2",
  "description": "Znight HTTP plugin: controllers, routing, guards, interceptors, validation with Fastify, Express or Hono",
  "license": "MIT",
  "author": "Ugho STEPHAN",
  "homepage": "https://github.com/znight-org/znight/tree/main/packages/http#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/znight-org/znight.git",
    "directory": "packages/http"
  },
  "bugs": "https://github.com/znight-org/znight/issues",
  "keywords": [
    "znight",
    "http",
    "rest",
    "controllers",
    "routing",
    "guards",
    "interceptors",
    "validation",
    "standard-schema",
    "fastify",
    "express",
    "hono",
    "bun"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@znight/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./path": {
      "@znight/source": "./src/path.ts",
      "types": "./dist/path.d.mts",
      "default": "./dist/path.mjs"
    },
    "./node": {
      "@znight/source": "./src/adapters/node.ts",
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    },
    "./fastify": {
      "@znight/source": "./src/adapters/fastify.ts",
      "types": "./dist/fastify.d.mts",
      "default": "./dist/fastify.mjs"
    },
    "./express": {
      "@znight/source": "./src/adapters/express.ts",
      "types": "./dist/express.d.mts",
      "default": "./dist/express.mjs"
    },
    "./hono": {
      "@znight/source": "./src/adapters/hono.ts",
      "types": "./dist/hono.d.mts",
      "default": "./dist/hono.mjs"
    },
    "./compiler": {
      "@znight/source": "./src/compiler/index.ts",
      "types": "./dist/compiler.d.mts",
      "default": "./dist/compiler.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@znight/core": "workspace:*"
  },
  "peerDependencies": {
    "@hono/node-server": "^2.1.5",
    "express": "^5.3.0",
    "fastify": "^5.12.7",
    "hono": "^4.13.14",
    "light-my-request": "^6.8.0",
    "@znight/compiler": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@hono/node-server": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "light-my-request": {
      "optional": true
    },
    "@znight/compiler": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "2.1.5",
    "@types/express": "5.0.6",
    "express": "5.3.0",
    "fastify": "5.12.7",
    "hono": "4.13.14",
    "valibot": "1.5.0",
    "zod": "catalog:",
    "light-my-request": "6.8.0",
    "@znight/compiler": "workspace:*"
  },
  "znight": {
    "apiVersion": 1,
    "compiler": "@znight/http/compiler",
    "provides": [
      {
        "export": "HttpContext",
        "plugin": "HttpPlugin",
        "scope": "request"
      },
      {
        "export": "RequestId",
        "plugin": "HttpPlugin",
        "scope": "request"
      },
      {
        "export": "HttpPlugin",
        "plugin": "HttpPlugin",
        "scope": "singleton"
      }
    ]
  }
}
