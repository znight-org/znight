{
  "name": "@znight/http",
  "version": "0.1.0",
  "description": "Znight HTTP plugin: controllers, routing, guards, interceptors, validation with Fastify, Express or Hono",
  "license": "MIT",
  "author": "Ugho STEPHAN",
  "homepage": "https://github.com/ugho49/Znight/tree/main/packages/http#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ugho49/Znight.git",
    "directory": "packages/http"
  },
  "bugs": "https://github.com/ugho49/Znight/issues",
  "keywords": ["znight", "http", "fastify", "express", "hono", "controllers", "rest"],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@znight/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@znight/core": "workspace:*"
  }
}
