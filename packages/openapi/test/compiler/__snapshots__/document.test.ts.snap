  "components": {
    "schemas": {
      "BookResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string",
            "description": "The title.",
            "minLength": 1,
            "examples": [
              "Dune"
            ]
          },
          "isbn": {
            "type": "string"
          },
          "genre": {
            "$ref": "#/components/schemas/Genre"
          },
          "publishedYear": {
            "type": [
              "number",
              "null"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "coverUrl": {
            "type": "string"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "deprecated": true
          }
        },
        "required": [
          "createdAt",
          "genre",
          "id",
          "isbn",
          "publishedYear",
          "tags",
          "title"
        ],
        "description": "A book of the shelf."
      },
      "Card": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "const": "card"
          },
          "last4": {
            "type": "string"
          }
        },
        "required": [
          "last4",
          "method"
        ]
      },
      "CoverForm": {
        "type": "object",
        "properties": {
          "caption": {
            "type": "string"
          }
        }
      },
      "CreateBook": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "isbn": {
            "type": "string",
            "pattern": "^\\\\d{13}$"
          },
          "tags": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "year": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "isbn",
          "year"
        ]
      },
      "Genre": {
        "type": "string",
        "enum": [
          "novel",
          "poetry"
        ],
        "description": "Literary genres."
      },
      "HttpErrorBody": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {}
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      },
