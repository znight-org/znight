        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/CoverForm"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "cover": {
                        "type": "string",
                        "contentMediaType": "application/octet-stream",
                        "description": "At most 2 MiB",
                        "x-znight-max-size": 2097152
                      }
                    },
                    "required": [
                      "cover"
                    ]
                  }
                ]
              },
              "encoding": {
                "cover": {
                  "contentType": "image/png, image/jpeg"
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "number"
                    },
                    "size": {
                      "type": "number"
                    }
                  },
                  "required": [
