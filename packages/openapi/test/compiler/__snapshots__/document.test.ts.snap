// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`bookshelf fixture matches the snapshot 1`] = `
"{
  "openapi": "3.1.1",
  "info": {
    "title": "Bookshelf API",
    "version": "1.2.3",
    "contact": {
      "email": "api@example.com"
    },
    "description": "A shelf of books with a cover each.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "security": [
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Books",
      "description": "The shelf"
    },
    {
      "name": "Order",
      "description": "Orders of books."
    }
  ],
  "paths": {
    "/books": {
      "get": {
        "operationId": "book.list",
        "summary": "List books",
        "description": "Sorted and paginated, filtered by text and tags.",
        "tags": [
          "Books"
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Case-insensitive search in titles.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tag",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "style": "form",
            "explode": true
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "author",
                "title",
                "year"
              ],
              "default": "title"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size.",
            "schema": {
              "type": "number",
              "default": 20
            }
          },
          {
            "name": "x-tenant",
            "in": "header",
            "description": "Tenant of the shelf",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "cache-control": {
                "schema": {
                  "type": "string"
                },
                "example": "no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_BookResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        },
        "security": [
          {
            "oauth2": [
              "reader"
            ]
          }
        ]
      },
      "post": {
        "operationId": "book.create",
        "summary": "Add a book",
        "tags": [
          "Books"
        ],
        "parameters": [
          {
            "name": "x-tenant",
            "in": "header",
            "description": "Tenant of the shelf",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBook"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The new book. Its URL is in the \`location\` header.",
            "headers": {
              "location": {
                "description": "URL of the new book",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "description": "A book with this ISBN is already on the shelf",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpErrorBody"
                }
              }
            }
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          }
        },
        "security": [
          {
            "oauth2": [
              "admin"
            ]
          }
        ]
      }
    },
