{
  "name": "@znight/cli",
  "version": "0.1.0",
  "description": "Znight CLI: scaffold projects, generate code, run dev server and builds",
  "license": "MIT",
  "author": "Ugho STEPHAN",
  "homepage": "https://github.com/znight-org/znight/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/znight-org/znight.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/znight-org/znight/issues",
  "keywords": ["znight", "cli", "scaffolding", "generator", "dependency-injection", "vite"],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@znight/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./orphan-guard": {
      "@znight/source": "./src/dev/orphan-guard.ts",
      "default": "./dist/dev/orphan-guard.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test:e2e": "ZNIGHT_CLI_E2E=1 bun test --conditions=@znight/source test/e2e.test.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@znight/core": "workspace:*",
    "citty": "^0.2.2",
    "picocolors": "^1.1.1"
  },
  "bin": {
    "znight": "./dist/cli.mjs"
  },
  "devDependencies": {
    "vite": "catalog:",
    "@znight/compiler": "workspace:*",
    "@znight/openapi": "workspace:*",
    "@znight/schedule": "workspace:*"
  },
  "peerDependencies": {
    "@znight/compiler": "workspace:^",
    "vite": "^8.0.0",
    "@znight/openapi": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@znight/compiler": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "@znight/openapi": {
      "optional": true
    }
  }
}
