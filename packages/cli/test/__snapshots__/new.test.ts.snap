,
  "src/app.ts": 
"import { ConfigPlugin } from '@znight/config'
import type { Plugin } from '@znight/core'
import { HttpPlugin } from '@znight/http'
import { fastifyAdapter } from '@znight/http/fastify'
import { MessagingPlugin } from '@znight/messaging'
import { memory } from '@znight/messaging/memory'
import { type LoggerLevel, ObservabilityPlugin } from '@znight/observability'

import { AppConfig } from './app/app.config.js'

/** What the tests change in the production wiring. */
export interface AppOptions {
  /** HTTP port. Default: AppConfig.port (PORT, 3000). Tests pass 0 (TestApp sends requests in memory). */
  readonly port?: number
  /** Minimum log level. Default: LOG_LEVEL, otherwise info. Tests pass 'silent'. */
  readonly logLevel?: LoggerLevel
}

/**
 * The plugins of the application, used by src/main.ts and by the tests (TestApp.create): the tests
 * run the production wiring.
 */
export function plugins(options: AppOptions = {}): Plugin[] {
  return [
    // first, so that its hooks wrap everything; metrics (with prom-client) and tracing are off
    ObservabilityPlugin.configure(container => ({
      logging: {
        name: 'my-service',
        // default: the LOG_LEVEL environment variable, otherwise info
        level: options.logLevel,
        // human-readable logs in development (\`znight dev\`), JSON logs in production
        pretty: container.get(AppConfig).environment === 'development',
      },
      metrics: false,
      tracing: false,
    })),
    // loads .env files and the environment, validates every @Config class before anything starts
    ConfigPlugin.configure(),
    // in-memory broker for development: use rabbitmq(), sqs() or kafka() in production
    MessagingPlugin.configure({ driver: memory() }),
    HttpPlugin.configure(container => ({
      adapter: fastifyAdapter(),
      port: options.port ?? container.get(AppConfig).port,
    })),
  ]
}
"
,
  "src/app/app.config.ts": 
"import { Config, Env } from '@znight/config'

/**
 * Settings of the application, validated at boot by ConfigPlugin. Each property is read from the
 * environment (or a .env file): APP_<PROPERTY> by default, or the name given to @Env. Properties
 * with an initializer are optional; their type selects the coercion ("3000" -> 3000).
 */
@Config('app')
export class AppConfig {
  /** HTTP port (PORT). */
  @Env('PORT')
  port = 3000

  /** Greeting used by GreetingService (APP_GREETING). */
  greeting = 'Hello'

  /** Runtime environment (NODE_ENV): \`znight dev\` sets "development"; unset, the application runs as in production. */
  @Env('NODE_ENV')
  environment = 'production'
}
