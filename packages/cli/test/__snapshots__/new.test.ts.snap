,
  "src/app.ts": 
"import type { Plugin } from '@znight/core'
import { GraphQLPlugin } from '@znight/graphql'
import { HttpPlugin } from '@znight/http'
import { fastifyAdapter } from '@znight/http/fastify'
import { type LoggerLevel, ObservabilityPlugin } from '@znight/observability'
import { OpenApiPlugin } from '@znight/openapi'
import { WebSocketPlugin } from '@znight/websocket'

/** What the tests change in the production wiring. */
export interface AppOptions {
  /** HTTP port. Default: PORT, otherwise 3000. Tests pass 0 (TestApp sends requests in memory). */
  readonly port?: number
  /** Minimum log level. Default: LOG_LEVEL, otherwise info. Tests pass 'silent'. */
  readonly logLevel?: LoggerLevel
}

/**
 * The plugins of the application, used by src/main.ts and by the tests (TestApp.create): the tests
 * run the production wiring.
 */
export function plugins(options: AppOptions = {}): Plugin[] {
  return [
    // first, so that its hooks wrap everything; metrics (with prom-client) and tracing are off
    ObservabilityPlugin.configure({
      logging: {
        name: 'my-service',
        // default: the LOG_LEVEL environment variable, otherwise info
        level: options.logLevel,
        // human-readable logs in development (\`znight dev\`), JSON logs in production
        pretty: process.env['NODE_ENV'] === 'development',
      },
      metrics: false,
      tracing: false,
    }),
    HttpPlugin.configure({ adapter: fastifyAdapter(), port: options.port ?? Number(process.env.PORT ?? 3000) }),
    // GET /openapi.json and the API reference at /docs, with Swagger UI (document options: src/openapi.ts)
    OpenApiPlugin.configure({ ui: 'swagger' }),
    // POST /graphql, GET /graphql (GraphiQL in development): the schema is derived from the resolvers
    GraphQLPlugin.configure(),
    // WebSocket gateways on the HTTP server's port (ws on Node.js, Bun's own WebSocket on Bun)
    WebSocketPlugin.configure(),
  ]
}
"
,
  "src/app/greeting.controller.ts": 
"import { Body, Controller, Get, Param, Post, Query } from '@znight/http'

import { CreateGreeting } from './greeting.schemas.js'
import { GreetingService } from './greeting.service.js'

@Controller('/greetings')
export class GreetingController {
  constructor(private readonly greetings: GreetingService) {}

  /** GET /greetings/Ada?excited=true: route and query parameters are coerced to their types. */
  @Get('/:name')
  greet(@Param('name') name: string, @Query('excited') excited?: boolean): { message: string } {
    return { message: this.greetings.greet(name, excited) }
  }

  /** POST /greetings {"name": "Ada"}: the body is validated by the schema (400 otherwise). */
  @Post()
  create(@Body(CreateGreeting) input: CreateGreeting): { message: string } {
    return { message: this.greetings.greet(input.name, input.excited) }
  }
}
"
,
  "src/app/greeting.gateway.ts": 
"import { Gateway, OnMessage, Payload } from '@znight/websocket'

import { CreateGreeting } from './greeting.schemas.js'
import { GreetingService } from './greeting.service.js'

/**
 * WebSocket gateway on ws://localhost:3000/ws, served by the HTTP server. Frames are JSON: the
 * request {"event": "greet", "data": {"name": "Ada"}, "id": 1} is answered with
 * {"id": 1, "data": {"message": "Hello, Ada."}}.
 */
@Gateway('/ws')
export class GreetingGateway {
  constructor(private readonly greetings: GreetingService) {}

  /** The payload is validated by the schema (a BAD_REQUEST error reply otherwise). */
  @OnMessage('greet')
  greet(@Payload(CreateGreeting) input: CreateGreeting): { message: string } {
    return { message: this.greetings.greet(input.name, input.excited) }
  }
}
"
,
  "src/app/greeting.resolver.ts": 
"import { Args, Query, Resolver } from '@znight/graphql'

import { GreetingService } from './greeting.service.js'

/** A greeting. */
export interface Greeting {
  readonly message: string
}

/**
 * GraphQL resolver (code-first): the compiler derives the schema from the TypeScript types and the
 * JSDoc, \`type Query { greeting(name: String!): Greeting! }\` here.
 */
@Resolver()
export class GreetingResolver {
  constructor(private readonly greetings: GreetingService) {}

  /**
   * Greets someone.
   * @param name Who to greet.
   */
  @Query()
  greeting(@Args('name') name: string): Greeting {
    return { message: this.greetings.greet(name) }
  }
}
"
,
  "src/app/greeting.schemas.ts": 
"import { z } from 'zod'

/** Body of POST /greetings. */
export const CreateGreeting = z.object({
  name: z.string().trim().min(1).max(100),
  excited: z.boolean().default(false),
})
export type CreateGreeting = z.output<typeof CreateGreeting>
"
,
  "src/app/greeting.service.ts": 
"import { Injectable } from '@znight/core'
import { Logger } from '@znight/observability'

@Injectable()
export class GreetingService {
  // dependencies are resolved at build time from the parameter types
  constructor(
    private readonly logger: Logger,
  ) {}

  greet(name: string, excited = false): string {
    this.logger.debug('Greeting', { name, excited })
    return \`\${'Hello'}, \${name}\${excited ? '!' : '.'}\`
  }
}
"
,
  "src/app/health.controller.ts": 
"import { Controller, Get } from '@znight/http'

@Controller('/health')
export class HealthController {
  /** GET /health */
  @Get()
  check(): { status: 'ok'; uptime: number } {
    return { status: 'ok', uptime: Math.round(process.uptime()) }
  }
}
"
,
  "src/main.ts": 
"// Written by the compiler from your decorated classes: the whole wiring, no module to declare
import { createApplication } from './.znight/container.generated.js'
import { plugins } from './app.js'

const app = await createApplication({ plugins: plugins() })

// SIGINT / SIGTERM stop the application gracefully (in-flight requests are drained)
await app.start()
"
