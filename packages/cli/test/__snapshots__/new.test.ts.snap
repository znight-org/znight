"{
  "name": "my-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "znight dev",
    "build": "znight build",
    "start": "znight start",
    "generate": "znight generate",
    "typecheck": "znight generate && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@znight/core": "^0.1.0",
    "@znight/http": "^0.1.0",
    "express": "^5.3.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@znight/cli": "^0.1.0",
    "@znight/compiler": "^0.1.0",
    "@znight/testing": "^0.1.0",
    "light-my-request": "^6.8.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
"
,
  "src/app.ts": 
"import type { Plugin } from '@znight/core'
import { HttpPlugin } from '@znight/http'
import { expressAdapter } from '@znight/http/express'

/** What the tests change in the production wiring. */
export interface AppOptions {
  /** HTTP port. Default: PORT, otherwise 3000. Tests pass 0 (TestApp sends requests in memory). */
  readonly port?: number
}

/**
 * The plugins of the application, used by src/main.ts and by the tests (TestApp.create): the tests
 * run the production wiring.
 */
export function plugins(options: AppOptions = {}): Plugin[] {
  return [
    HttpPlugin.configure({ adapter: expressAdapter(), port: options.port ?? Number(process.env.PORT ?? 3000) }),
  ]
}
"
