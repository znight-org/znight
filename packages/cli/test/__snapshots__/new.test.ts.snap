  "src/main.ts": 
"import { Application } from '@znight/core'
import { HttpPlugin } from '@znight/http'
import { expressAdapter } from '@znight/http/express'

import { __ZNIGHT_METADATA__ } from './.znight/container.generated.js'

const app = await Application.create({
  metadata: __ZNIGHT_METADATA__,
  plugins: [
    HttpPlugin.configure({ adapter: expressAdapter(), port: Number(process.env.PORT ?? 3000) }),
  ],
})

// SIGINT / SIGTERM stop the application gracefully (in-flight requests are drained)
await app.start()
"
