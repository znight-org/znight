  "src/openapi.ts": 
"import { OpenApiDocument } from '@znight/openapi'

// Options of the OpenAPI document (GET /openapi.json, the API reference at /docs), read by the
// compiler. The class is a marker: it is never instantiated.
@OpenApiDocument({
  info: {
    title: 'my-service',
    description: 'The HTTP API of my-service.',
    version: '1.0.0',
  },
})
export class Api {}
"
