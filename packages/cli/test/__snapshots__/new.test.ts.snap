import { Logger } from '@znight/observability'

import { AppConfig } from './app.config.js'

@Injectable()
export class GreetingService {
  // dependencies are resolved at build time from the parameter types
  constructor(
    private readonly config: AppConfig,
    private readonly logger: Logger,
  ) {}

  greet(name: string, excited = false): string {
    this.logger.debug('Greeting', { name, excited })
    return \`\${this.config.greeting}, \${name}\${excited ? '!' : '.'}\`
  }
}
"
