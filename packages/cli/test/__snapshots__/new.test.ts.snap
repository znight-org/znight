  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "znight dev",
    "build": "znight build",
    "start": "znight start",
    "generate": "znight generate",
    "typecheck": "znight generate && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@znight/config": "^0.1.0",
    "@znight/core": "^0.1.0",
    "@znight/http": "^0.1.0",
    "@znight/observability": "^0.1.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@znight/cli": "^0.1.0",
    "@znight/compiler": "^0.1.0",
    "@znight/testing": "^0.1.0",
    "light-my-request": "^6.8.0",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
