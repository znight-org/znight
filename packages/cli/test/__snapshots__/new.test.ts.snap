"import { z } from 'zod'

/** Body of POST /greetings. */
export const CreateGreeting = z.object({
  name: z.string().trim().min(1).max(100),
  excited: z.boolean().default(false),
})
export type CreateGreeting = z.output<typeof CreateGreeting>
