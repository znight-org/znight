"import { Application } from '@znight/core'
import { HttpPlugin } from '@znight/http'
import { honoAdapter } from '@znight/http/hono'
import { MessagingPlugin } from '@znight/messaging'
import { memory } from '@znight/messaging/memory'

import { __ZNIGHT_METADATA__ } from './.znight/container.generated.js'

const app = await Application.create({
  metadata: __ZNIGHT_METADATA__,
  plugins: [
    // in-memory broker for development: use rabbitmq(), sqs() or kafka() in production
    MessagingPlugin.configure({ driver: memory() }),
    HttpPlugin.configure({ adapter: honoAdapter(), port: Number(process.env.PORT ?? 3000) }),
  ],
})

// SIGINT / SIGTERM stop the application gracefully (in-flight requests are drained)
await app.start()
"
