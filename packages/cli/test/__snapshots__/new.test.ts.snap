  "src/app/health.controller.ts": 
"import { Controller, Get } from '@znight/http'

@Controller('/health')
export class HealthController {
  /** GET /health */
  @Get()
  check(): { status: 'ok'; uptime: number } {
    return { status: 'ok', uptime: Math.round(process.uptime()) }
  }
}
