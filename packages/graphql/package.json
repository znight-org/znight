{
  "name": "@znight/graphql",
  "version": "0.5.0",
  "description": "Znight GraphQL: code-first GraphQL whose schema is derived from TypeScript types at build time, on graphql-js 17",
  "license": "MIT",
  "author": "Ugho STEPHAN",
  "homepage": "https://github.com/znight-org/znight/tree/main/packages/graphql#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/znight-org/znight.git",
    "directory": "packages/graphql"
  },
  "bugs": "https://github.com/znight-org/znight/issues",
  "keywords": ["znight", "graphql", "code-first", "dataloader", "subscriptions", "sse", "yoga"],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@znight/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./compiler": {
      "@znight/source": "./src/compiler/index.ts",
      "types": "./dist/compiler.d.mts",
      "default": "./dist/compiler.mjs"
    },
    "./testing": {
      "@znight/source": "./src/testing.ts",
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    },
    "./yoga": {
      "@znight/source": "./src/yoga.ts",
      "types": "./dist/yoga.d.mts",
      "default": "./dist/yoga.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "bun test --conditions=@znight/source test",
    "test:integration": "ZNIGHT_INTEGRATION=1 bun test --conditions=@znight/source --timeout 180000 test/recipes/redis-pubsub.integration.test.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@znight/core": "workspace:*",
    "dataloader": "^2.2.3"
  },
  "peerDependencies": {
    "@znight/http": "workspace:^",
    "@znight/compiler": "workspace:^",
    "@znight/testing": "workspace:^",
    "graphql": "^17.0.2",
    "graphql-yoga": "^6.0.1"
  },
  "peerDependenciesMeta": {
    "@znight/compiler": {
      "optional": true
    },
    "@znight/testing": {
      "optional": true
    },
    "graphql-yoga": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testcontainers/redis": "12.2.1",
    "@znight/compiler": "workspace:*",
    "@znight/http": "workspace:*",
    "@znight/testing": "workspace:*",
    "graphql": "17.0.2",
    "graphql-http": "1.23.1",
    "graphql-sse": "2.6.3",
    "graphql-yoga": "6.0.1",
    "ioredis": "6.0.0",
    "testcontainers": "12.2.1",
    "valibot": "1.5.0",
    "zod": "catalog:"
  },
  "znight": {
    "apiVersion": 1,
    "compiler": "@znight/graphql/compiler",
    "provides": [
      {
        "export": "GraphQLContext",
        "plugin": "GraphQLPlugin",
        "scope": "request"
      },
      {
        "export": "PubSub",
        "plugin": "GraphQLPlugin",
        "scope": "singleton"
      },
      {
        "export": "GraphQLPlugin",
        "plugin": "GraphQLPlugin",
        "scope": "singleton"
      }
    ]
  }
}
