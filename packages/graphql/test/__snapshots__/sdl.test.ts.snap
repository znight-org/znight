// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`printSdl prints the SDL of RFC 0005 §5.13 1`] = `
"type Author {
  kind: String!
  id: ID!
  name: String!
  born: Int
}

"""A book of the catalog."""
type Book {
  kind: String!
  id: ID!
  title: String!
  isbn: String!

  """Year of first publication, \`null\` when unknown."""
  publishedYear: Int
  genre: Genre!
  tags: [String!]!
  createdAt: DateTime!
  category: String @deprecated(reason: "Use \`tags\`.")

  """
  Who wrote the book. Batched: one repository call per execution, whatever the number of books.
  """
  author: Author!
}

type BookPage {
  items: [Book!]!
  total: Int!
  hasMore: Boolean!
}

"""Sort orders of the book list."""
enum BookSort {
  title
  newest
}

scalar DateTime @specifiedBy(url: "https://datatracker.ietf.org/doc/html/rfc3339")

"""Literary genres."""
enum Genre {
  Fantasy
  ScienceFiction
  Mystery
}

type Mutation {
  """Adds a book to the catalog."""
  addBook(input: NewBookInput!): Book!
}

"""
A new book. The interface is the GraphQL input type, the schema of the same name validates it.
"""
input NewBookInput {
  title: String!
  isbn: String!
  authorId: String!
  genre: Genre!
  publishedYear: Int
  tags: [String!]
}

type Query {
  """Books of the catalog, filtered and paginated."""
  books(
    """Case-insensitive search in titles."""
    search: String
    genre: Genre
    sort: BookSort = title
    limit: Int = 20
    offset: Int = 0
  ): BookPage!

  """One book."""
  book(
    """The id of the book."""
    id: ID!
  ): Book
}

type Subscription {
  """Books added from now on, optionally of one genre."""
  bookAdded(genre: Genre): Book!
}"
`;
