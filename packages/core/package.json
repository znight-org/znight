{
  "name": "@znight/core",
  "version": "0.1.0",
  "description": "Znight core runtime: compile-time DI container, lifecycle, plugins and marker decorators",
  "license": "MIT",
  "author": "Ugho STEPHAN",
  "homepage": "https://github.com/znight-org/znight/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/znight-org/znight.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/znight-org/znight/issues",
  "keywords": ["znight", "dependency-injection", "di", "ioc", "container", "framework"],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@znight/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test"
  },
  "publishConfig": {
    "access": "public"
  },
  "znight": {
    "apiVersion": 1,
    "provides": [
      {
        "export": "Container",
        "plugin": "@znight/core",
        "scope": "singleton"
      },
      {
        "export": "Application",
        "plugin": "Application",
        "scope": "singleton"
      },
      {
        "export": "Hooks",
        "plugin": "Application",
        "scope": "singleton"
      },
      {
        "export": "CoreLogger",
        "plugin": "Application",
        "scope": "singleton"
      }
    ]
  }
}
