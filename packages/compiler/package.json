{
  "name": "@znight/compiler",
  "version": "0.1.0",
  "description": "Znight compiler: Vite plugin that analyzes your code and generates the DI container at build time",
  "license": "MIT",
  "author": "Ugho STEPHAN",
  "homepage": "https://github.com/ugho49/Znight/tree/main/packages/compiler#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ugho49/Znight.git",
    "directory": "packages/compiler"
  },
  "bugs": "https://github.com/ugho49/Znight/issues",
  "keywords": ["znight", "vite-plugin", "compiler", "dependency-injection", "codegen"],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@znight/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@znight/core": "workspace:*"
  },
  "peerDependencies": {
    "vite": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
