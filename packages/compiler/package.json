{
  "name": "@znight/compiler",
  "version": "0.1.0",
  "description": "Znight compiler: Vite plugin that analyzes your code and generates the DI container at build time",
  "license": "MIT",
  "author": "Ugho STEPHAN",
  "homepage": "https://github.com/znight-org/znight/tree/main/packages/compiler#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/znight-org/znight.git",
    "directory": "packages/compiler"
  },
  "bugs": "https://github.com/znight-org/znight/issues",
  "keywords": [
    "znight",
    "vite-plugin",
    "bun-plugin",
    "compiler",
    "dependency-injection",
    "codegen",
    "static-analysis",
    "decorators"
  ],
  "type": "module",
  "sideEffects": ["./dist/bun.mjs", "./src/bun.ts"],
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@znight/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./bun": {
      "@znight/source": "./src/bun.ts",
      "types": "./dist/bun.d.mts",
      "default": "./dist/bun.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@znight/core": "workspace:*",
    "magic-string": "^1.4.5",
    "oxc-parser": "^0.156.0",
    "oxc-resolver": "^11.24.2",
    "picocolors": "^1.1.1",
    "tinyglobby": "^0.2.17"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "vite": "catalog:"
  }
}
