{
  "name": "@znight/observability",
  "type": "module",
  "exports": {
    ".": { "types": "./index.d.ts", "default": "./index.js" }
  },
  "znight": {
    "apiVersion": 1,
    "provides": [
      { "export": "Logger", "plugin": "ObservabilityPlugin", "scope": "singleton" },
      { "export": "LoggedInterceptor", "plugin": "ObservabilityPlugin" },
      { "export": "Tracer", "plugin": "ObservabilityPlugin", "optional": true }
    ],
    "interceptors": [{ "decorator": "Logged", "interceptor": "LoggedInterceptor" }]
  }
}
