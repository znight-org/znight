{
  "name": "@fixture/logging",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": { "types": "./index.d.ts", "default": "./index.js" }
  },
  "znight": {
    "apiVersion": 1,
    "provides": [
      { "export": "Logger", "plugin": "LoggingPlugin", "scope": "singleton" },
      { "export": "RequestId", "plugin": "LoggingPlugin", "scope": "request" },
      { "export": "LoggedInterceptor", "plugin": "LoggingPlugin", "scope": "singleton" }
    ],
    "interceptors": [{ "decorator": "Logged", "interceptor": "LoggedInterceptor" }]
  }
}
