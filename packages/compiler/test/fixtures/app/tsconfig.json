{
  "compilerOptions": {
    "target": "ES2024",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "experimentalDecorators": true,
    "customConditions": ["@znight/source"],
    "paths": {
      "@app/*": ["./src/*"],
      "#shared/*": ["./shared/*"]
    }
  },
  "include": ["src", "shared"]
}
