{
  "name": "@fixture/manifest-lib",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "@znight/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "znight": {
    "apiVersion": 1,
    "library": "source",
    "compiler": "@fixture/manifest-lib/compiler",
    "provides": [
      {
        "export": "Clock",
        "plugin": "ClockPlugin",
        "scope": "singleton"
      }
    ],
    "interceptors": [
      {
        "decorator": "Timed",
        "interceptor": "TimedInterceptor"
      }
    ]
  }
}
