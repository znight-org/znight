{
  "name": "@znight/config",
  "version": "0.1.0",
  "description": "Znight config plugin: type-safe configuration classes loaded from env, files and secret stores",
  "license": "MIT",
  "author": "Ugho STEPHAN",
  "homepage": "https://github.com/ugho49/Znight/tree/main/packages/config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ugho49/Znight.git",
    "directory": "packages/config"
  },
  "bugs": "https://github.com/ugho49/Znight/issues",
  "keywords": ["znight", "config", "configuration", "env", "dotenv", "secrets"],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@znight/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@znight/core": "workspace:*"
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "3.1156.0",
    "yaml": "2.9.1"
  }
}
