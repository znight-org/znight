{
  "name": "@znight/config",
  "version": "0.1.2",
  "description": "Znight config plugin: type-safe configuration classes loaded from env, files and secret stores",
  "license": "MIT",
  "author": "Ugho STEPHAN",
  "homepage": "https://github.com/znight-org/znight/tree/main/packages/config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/znight-org/znight.git",
    "directory": "packages/config"
  },
  "bugs": "https://github.com/znight-org/znight/issues",
  "keywords": [
    "znight",
    "config",
    "configuration",
    "env",
    "dotenv",
    "secrets",
    "vault",
    "aws-secrets-manager",
    "yaml",
    "twelve-factor"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@znight/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./compiler": {
      "@znight/source": "./src/compiler/index.ts",
      "types": "./dist/compiler.d.mts",
      "default": "./dist/compiler.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@znight/core": "workspace:*"
  },
  "peerDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "yaml": "^2.0.0",
    "@znight/compiler": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-secrets-manager": {
      "optional": true
    },
    "yaml": {
      "optional": true
    },
    "@znight/compiler": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "3.1157.0",
    "yaml": "2.9.1",
    "@znight/compiler": "workspace:*"
  },
  "znight": {
    "apiVersion": 1,
    "compiler": "@znight/config/compiler",
    "provides": [
      {
        "export": "ConfigSource",
        "plugin": "ConfigPlugin",
        "scope": "singleton"
      }
    ]
  }
}
