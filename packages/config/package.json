{
  "name": "@znight/config",
  "version": "0.9.0",
  "description": "Znight config plugin: type-safe configuration classes loaded from env, files and secret stores",
  "license": "MIT",
  "author": "Ugho STEPHAN",
  "homepage": "https://znight-org.github.io/znight/packages/config",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/znight-org/znight.git",
    "directory": "packages/config"
  },
  "bugs": "https://github.com/znight-org/znight/issues",
  "keywords": [
    "znight",
    "config",
    "configuration",
    "env",
    "dotenv",
    "secrets",
    "vault",
    "aws-secrets-manager",
    "gcp-secret-manager",
    "azure-key-vault",
    "oci-vault",
    "yaml",
    "twelve-factor"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@znight/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./compiler": {
      "@znight/source": "./src/compiler/index.ts",
      "types": "./dist/compiler.d.mts",
      "default": "./dist/compiler.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@znight/core": "workspace:*"
  },
  "peerDependencies": {
    "@azure/identity": "^4.0.0",
    "@azure/keyvault-secrets": "^4.0.0",
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "@google-cloud/secret-manager": "^6.0.0 || ^7.0.0 || ^8.0.0",
    "oci-common": "^2.0.0",
    "oci-secrets": "^2.0.0",
    "yaml": "^2.0.0",
    "@znight/compiler": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@azure/identity": {
      "optional": true
    },
    "@azure/keyvault-secrets": {
      "optional": true
    },
    "@aws-sdk/client-secrets-manager": {
      "optional": true
    },
    "@google-cloud/secret-manager": {
      "optional": true
    },
    "oci-common": {
      "optional": true
    },
    "oci-secrets": {
      "optional": true
    },
    "yaml": {
      "optional": true
    },
    "@znight/compiler": {
      "optional": true
    }
  },
  "devDependencies": {
    "@azure/identity": "4.14.0",
    "@azure/keyvault-secrets": "4.12.0",
    "@aws-sdk/client-secrets-manager": "3.1164.0",
    "@google-cloud/secret-manager": "7.2.0",
    "oci-common": "2.144.0",
    "oci-secrets": "2.144.0",
    "yaml": "2.9.1",
    "@znight/compiler": "workspace:*"
  },
  "znight": {
    "apiVersion": 1,
    "compiler": "@znight/config/compiler",
    "provides": [
      {
        "export": "ConfigSource",
        "plugin": "ConfigPlugin",
        "scope": "singleton"
      }
    ]
  }
}
