{
  "name": "@znight/messaging",
  "version": "0.7.3",
  "description": "Znight messaging plugin: consumers, retries and dead-letter queues with RabbitMQ, SQS, Kafka, Google Cloud Pub/Sub, NATS JetStream, Azure Service Bus or Redis Streams",
  "license": "MIT",
  "author": "Ugho STEPHAN",
  "homepage": "https://znight-org.github.io/znight/packages/messaging",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/znight-org/znight.git",
    "directory": "packages/messaging"
  },
  "bugs": "https://github.com/znight-org/znight/issues",
  "keywords": [
    "znight",
    "messaging",
    "rabbitmq",
    "amqp",
    "sqs",
    "kafka",
    "pubsub",
    "google-cloud-pubsub",
    "nats",
    "jetstream",
    "azure-service-bus",
    "redis",
    "redis-streams",
    "valkey",
    "consumer",
    "queue",
    "dead-letter-queue",
    "retry"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@znight/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./memory": {
      "@znight/source": "./src/drivers/memory.ts",
      "types": "./dist/memory.d.mts",
      "default": "./dist/memory.mjs"
    },
    "./rabbitmq": {
      "@znight/source": "./src/drivers/rabbitmq.ts",
      "types": "./dist/rabbitmq.d.mts",
      "default": "./dist/rabbitmq.mjs"
    },
    "./sqs": {
      "@znight/source": "./src/drivers/sqs.ts",
      "types": "./dist/sqs.d.mts",
      "default": "./dist/sqs.mjs"
    },
    "./kafka": {
      "@znight/source": "./src/drivers/kafka.ts",
      "types": "./dist/kafka.d.mts",
      "default": "./dist/kafka.mjs"
    },
    "./pubsub": {
      "@znight/source": "./src/drivers/pubsub.ts",
      "types": "./dist/pubsub.d.mts",
      "default": "./dist/pubsub.mjs"
    },
    "./nats": {
      "@znight/source": "./src/drivers/nats.ts",
      "types": "./dist/nats.d.mts",
      "default": "./dist/nats.mjs"
    },
    "./azure-service-bus": {
      "@znight/source": "./src/drivers/azure-service-bus.ts",
      "types": "./dist/azure-service-bus.d.mts",
      "default": "./dist/azure-service-bus.mjs"
    },
    "./redis": {
      "@znight/source": "./src/drivers/redis.ts",
      "types": "./dist/redis.d.mts",
      "default": "./dist/redis.mjs"
    },
    "./testing": {
      "@znight/source": "./src/testing.ts",
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    },
    "./compiler": {
      "@znight/source": "./src/compiler/index.ts",
      "types": "./dist/compiler.d.mts",
      "default": "./dist/compiler.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "bun test --conditions=@znight/source test",
    "test:integration": "ZNIGHT_INTEGRATION=1 bun test --conditions=@znight/source --timeout 180000 test/integration"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@znight/core": "workspace:*"
  },
  "peerDependencies": {
    "@azure/identity": "^4.0.0",
    "@azure/service-bus": "^7.9.0",
    "@aws-sdk/client-sqs": "^3.600.0",
    "@google-cloud/pubsub": "^6.0.0",
    "@nats-io/jetstream": "^3.0.0",
    "@nats-io/transport-node": "^3.0.0",
    "@platformatic/kafka": "^2.0.0",
    "amqplib": "^2.0.0",
    "ioredis": "^5.4.0 || ^6.0.0",
    "@znight/compiler": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@azure/identity": {
      "optional": true
    },
    "@azure/service-bus": {
      "optional": true
    },
    "@aws-sdk/client-sqs": {
      "optional": true
    },
    "@google-cloud/pubsub": {
      "optional": true
    },
    "@nats-io/jetstream": {
      "optional": true
    },
    "@nats-io/transport-node": {
      "optional": true
    },
    "@platformatic/kafka": {
      "optional": true
    },
    "amqplib": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "@znight/compiler": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-sqs": "3.1164.0",
    "@azure/identity": "4.14.1",
    "@azure/service-bus": "7.10.0",
    "@google-cloud/pubsub": "6.3.2",
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "@platformatic/kafka": "2.15.0",
    "@testcontainers/azureservicebus": "12.2.1",
    "@testcontainers/gcloud": "12.2.1",
    "@testcontainers/kafka": "12.2.1",
    "@testcontainers/localstack": "12.2.1",
    "@testcontainers/nats": "12.2.1",
    "@testcontainers/rabbitmq": "12.2.1",
    "@testcontainers/redis": "12.2.1",
    "@znight/compiler": "workspace:*",
    "amqplib": "2.2.1",
    "ioredis": "6.0.0",
    "testcontainers": "12.2.1",
    "zod": "catalog:"
  },
  "znight": {
    "apiVersion": 1,
    "compiler": "@znight/messaging/compiler",
    "provides": [
      {
        "export": "MessageBroker",
        "plugin": "MessagingPlugin",
        "scope": "singleton"
      },
      {
        "export": "InboundMessage",
        "plugin": "MessagingPlugin",
        "scope": "request"
      }
    ]
  }
}
