{
  "name": "@znight/websocket",
  "version": "0.0.0",
  "private": true,
  "description": "Znight WebSocket gateways served by the HTTP server, validated at build time (RFC 0003, in progress)",
  "license": "MIT",
  "author": "Ugho STEPHAN",
  "homepage": "https://github.com/znight-org/znight/tree/main/packages/websocket#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/znight-org/znight.git",
    "directory": "packages/websocket"
  },
  "bugs": "https://github.com/znight-org/znight/issues",
  "keywords": ["znight", "websocket", "realtime", "gateway"],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@znight/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "bun test --conditions=@znight/source test"
  },
  "dependencies": {
    "@znight/core": "workspace:*",
    "@znight/http": "workspace:*"
  },
  "devDependencies": {
    "ws": "8.22.0"
  }
}
