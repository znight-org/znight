{
  "name": "@znight/websocket",
  "version": "0.6.0",
  "description": "Znight WebSocket gateways served by the HTTP server, validated at build time",
  "license": "MIT",
  "author": "Ugho STEPHAN",
  "homepage": "https://github.com/znight-org/znight/tree/main/packages/websocket#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/znight-org/znight.git",
    "directory": "packages/websocket"
  },
  "bugs": "https://github.com/znight-org/znight/issues",
  "keywords": ["znight", "websocket", "realtime", "gateway"],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@znight/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./ws": {
      "@znight/source": "./src/transports/ws.ts",
      "types": "./dist/ws.d.mts",
      "default": "./dist/ws.mjs"
    },
    "./bun": {
      "@znight/source": "./src/transports/bun.ts",
      "types": "./dist/bun.d.mts",
      "default": "./dist/bun.mjs"
    },
    "./testing": {
      "@znight/source": "./src/testing/index.ts",
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    },
    "./compiler": {
      "@znight/source": "./src/compiler/index.ts",
      "types": "./dist/compiler.d.mts",
      "default": "./dist/compiler.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "bun test --conditions=@znight/source test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@znight/core": "workspace:*",
    "@znight/http": "workspace:*"
  },
  "peerDependencies": {
    "@znight/compiler": "workspace:^",
    "ws": "^8.21.0"
  },
  "peerDependenciesMeta": {
    "@znight/compiler": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@znight/compiler": "workspace:*",
    "@znight/testing": "workspace:*",
    "hono": "4.13.14",
    "ws": "8.22.0",
    "zod": "catalog:"
  },
  "znight": {
    "apiVersion": 1,
    "compiler": "@znight/websocket/compiler",
    "provides": [
      {
        "export": "WsServer",
        "plugin": "WebSocketPlugin",
        "scope": "singleton"
      },
      {
        "export": "WebSocketPlugin",
        "plugin": "WebSocketPlugin",
        "scope": "singleton"
      },
      {
        "export": "WsConnection",
        "plugin": "WebSocketPlugin",
        "scope": "request"
      }
    ]
  }
}
