{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Standalone (not extending tsconfig.base.json): VitePress bundles the config and the theme with
  // an esbuild version that does not know the "ES2024" target and warns about it.
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [".vitepress/**/*.ts"],
  "exclude": [".vitepress/cache", ".vitepress/dist"]
}
