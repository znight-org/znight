{
  // The NestJS defaults (`nest new`): decorator metadata emitted by tsc, read with reflect-metadata
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      // The typings of @whatwg-node/fetch (graphql-yoga) reference the DOM lib, whose BodyInit
      // breaks the Node.js globals: the same declarations on the existing globals, like packages/graphql
      "@whatwg-node/fetch": ["../../../packages/graphql/types/whatwg-fetch.d.ts"]
    }
  },
  "include": ["src"]
}
