{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "ESNext.Disposable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    // Znight decorators are TypeScript decorators: no emitDecoratorMetadata nor reflect-metadata
    "experimentalDecorators": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    // In-repo only: type-check against the TypeScript sources of the @znight/* workspace packages
    "customConditions": ["@znight/source"],
    "allowImportingTsExtensions": true
  },
  "include": ["src", "vite.config.ts"]
}
